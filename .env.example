# Copy to .env for local development. Bun loads it automatically. Never commit .env.
PUBLIC_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_LOGIN=your-github-login
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# 2FA after GitHub. Generate with `bun server/totp.ts your-github-login`, then add it in Google Authenticator via "Enter a setup key" (Time based).
TOTP_SECRET=
PORTAINER_URL=http://portainer.invalid
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=1
# Local only: a tcp:// Docker daemon. On the VPS leave unset to use /var/run/docker.sock.
DOCKER_HOST=tcp://localhost:2375
DATA_DIR=./.data
STATIC_DIR=dist
